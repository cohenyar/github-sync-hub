# Lovable Cloud is Meridian's only auth backend — these two values come
# from Lovable Cloud -> Users -> Auth (or Settings -> API), not a
# separately-created Supabase project. Lovable's own tooling also writes
# them into src/integrations/supabase/client.ts automatically; this repo's
# actual auth code (src/auth/supabaseClient.ts) reads them independently
# rather than importing that generated file directly (see that file's own
# doc comment for why).
#
# Never put a secret/service-role key here, or anywhere in this frontend
# project — only the public/publishable key belongs in a browser bundle. It
# is safe to ship because Row Level Security (see supabase/migrations) is
# what protects the data behind it, not the secrecy of this key.
#
# If these are left unset, the app still runs: sign-in shows a clear
# "not configured" notice instead of a broken control, and guest play works
# exactly as before (see src/auth/supabaseClient.ts).

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Older Supabase key naming, accepted as a fallback if you're pointing this
# app at a Supabase project that isn't managed through Lovable Cloud.
VITE_SUPABASE_ANON_KEY=

# Sentry error monitoring (free tier: 5,000 events/month, silently dropped
# past the cap, never billed). Production-only by design — see
# src/errorReporting/sentryClient.ts — so leaving this unset just means no
# error reporting anywhere, dev/test included, exactly like the Supabase
# vars above degrade to guest mode.
VITE_SENTRY_DSN=
