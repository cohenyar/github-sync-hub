# Lovable Cloud provisions these automatically into .env — you normally do
# not need to set anything by hand. They are public browser values (Row Level
# Security protects the data, not their secrecy). Never put a service-role
# key in this frontend project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
