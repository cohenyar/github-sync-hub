# Lovable Cloud is Meridian's only auth backend and normally provisions
# these automatically into .env — you don't usually need to set anything by
# hand. They are public browser values (Row Level Security, see
# supabase/migrations, protects the data — not the secrecy of this key).
# Never put a secret/service-role key here, or anywhere in this frontend
# project.
#
# The generated client (src/integrations/supabase/client.ts) throws at
# import time if either of the first two are missing, so local dev without
# real Lovable Cloud credentials needs a placeholder .env (gitignored, never
# committed) with syntactically-valid dummy values — see README/checkpoint
# notes. Guest play and every other feature work fine against a placeholder;
# only real sign-in/sign-up requires the real values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Sentry error monitoring (free tier: 5,000 events/month, silently dropped
# past the cap, never billed). Production-only by design — see
# src/errorReporting/sentryClient.ts — so leaving this unset just means no
# error reporting anywhere, dev/test included.
VITE_SENTRY_DSN=
