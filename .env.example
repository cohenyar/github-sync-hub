# Copy this file to .env.local (already git-ignored) and fill in the real
# values from your Supabase project dashboard: Project Settings -> API.
#
# Never put the service-role key here, or anywhere in this frontend project —
# only the public anon key belongs in a browser bundle. It is safe to ship
# because Row Level Security (see supabase/migrations) is what protects the
# data behind it, not the secrecy of this key.
#
# If these are left unset, the app still runs: sign-in is hidden and guest
# play works exactly as before (see src/auth/supabaseClient.ts).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
